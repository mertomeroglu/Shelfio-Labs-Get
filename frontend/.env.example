# GetShelfio frontend environment template.
# Copy to frontend/.env.local for local development. Do not put server-only secrets here.

NEXT_PUBLIC_SITE_URL=http://localhost:3007
NEXT_PUBLIC_COMPANY_SITE_URL=https://shelfiolabs.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:4017/api
NEXT_PUBLIC_SHELFIO_APP_URL=http://localhost:3000

# Server-side Next.js calls can use an internal API URL.
# This is not a secret, but it is intentionally not exposed as NEXT_PUBLIC_*.
API_INTERNAL_BASE_URL=http://localhost:4017/api
