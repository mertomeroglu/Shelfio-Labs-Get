# GetShelfio API environment template.
# Copy to backend/.env for local development. Do not commit real values.

APP_NAME=Shelfio
NODE_ENV=development
PORT=4017

# Public URLs and CORS
FRONTEND_ORIGIN=http://localhost:3007
PUBLIC_SITE_URL=http://localhost:3007
MAIN_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3007

# PostgreSQL
DATABASE_URL=postgresql://getshelfio:getshelfio_local_dev_password@localhost:5434/getshelfio_local
DATABASE_SSL=false

# Server-only secrets. Replace every placeholder before production.
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_TTL_SECONDS=86400
LICENSE_KEY_PEPPER=replace-with-a-long-random-license-pepper
LICENSE_KEY_ENCRYPTION_SECRET=replace-with-a-long-random-encryption-secret
CONTROL_API_INTERNAL_SECRET=replace-with-a-long-random-control-api-secret
SUPPORT_TOKEN_SECRET=replace-with-a-long-random-support-token-secret
SSO_CODE_TTL_SECONDS=120

# Cookies
COOKIE_NAME=shelfio_service_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email. Leave EMAIL_SEND_ENABLED=false unless SMTP is configured locally.
EMAIL_SEND_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Shelfio <support@example.com>"
DEMO_REQUEST_TO=support@example.com
DEMO_REQUEST_CC=
SUPPORT_TO=support@example.com
PASSWORD_RESET_FROM="Shelfio <support@example.com>"
PUBLIC_SUPPORT_EMAIL=support@example.com

# Optional Shelfio-Labs data export integration.
SHELFIO_LABS_API_URL=http://localhost:4000
SHELFIO_LABS_API_SECRET=replace-with-shared-local-control-secret

# Local prototype billing flags.
PAYMENT_TEST_MODE=true
CHECKOUT_ENABLED=true

# Local seed values. Use development-only accounts.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-local-admin-password
SEED_CUSTOMER_EMAIL=customer@example.com
SEED_CUSTOMER_PASSWORD=replace-with-local-customer-password
SEED_CUSTOMER_LICENSE_KEY=SHELFIO-LOCAL-EXAMPLE-KEY
